# Base de datos (Neon, vía la integración nativa de Vercel).
# Sin esta variable el sitio funciona igual, pero en solo lectura sobre la
# semilla: el Modo edición no puede guardar.
DATABASE_URL=

# Clave compartida que abre el Modo edición. Se la pasas a los novios aparte
# del link. Sin ella el botón de edición no aparece para nadie.
EDIT_PASSWORD=

# Almacenamiento de fotos (Vercel Blob). Sin esta variable todo lo demás
# funciona, pero no se pueden subir imágenes.
BLOB_READ_WRITE_TOKEN=
